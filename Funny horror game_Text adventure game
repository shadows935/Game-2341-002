# a list for the player to store items when picked up in game, sadly there is only one item a flashlight
inventory = []


def ask(options):
    """Show a numbered list of options and return the number the player picks."""
    print()
    for number, text in enumerate(options, start=1):
        print("%d) %s" % (number, text))
    while True:  # made to keep asking until the answer is vaild, if it is not vaild then it will continue to loop
        answer = input("> ").strip()
        if answer.isdigit() and 1 <= int(answer) <= len(options):
            return int(answer)
        print("Please type a number from 1 to %d." % len(options))


def end(key):
    """Print the title, story, and funny comment for the chosen ending."""
    title, story, joke = ENDINGS[key]  # this unpacks the the dictonary into the three variables so when it prints the statment it will print title, the story, and the joke for last
    print("\n*** " + title + " ***")
    print(story)
    print("\n" + joke)


def start():
    """Front yard: go inside or don't up to you."""
    print("You stand in front of a creepy old house. A crooked sign reads:\n"
          "'Welcome! Please ignore the screaming.'")
    choice = ask(["Go inside", "Run home"])
    if choice == 1:
        hall()
    else:
        end("home")


def hall():
    """Main hall: connects to every other room."""
    print("\nYou are in the dusty hall. A portrait on the wall winks at you.\n"
          "You decide not to think about that. Doors lead everywhere.")
    choice = ask(["Go to the kitchen", "Open the cellar door", "Climb the stairs"])
    if choice == 1:
        kitchen()
    elif choice == 2:
        cellar()
    else:
        bedroom()


def kitchen():
    """Kitchen: the flashlight is here."""
    print("\nThe kitchen smells like soup from the year 1823. A flashlight\n"
          "sits on the counter, next to a note: 'Do not eat the soup.'")
    choice = ask(["Take the flashlight", "Leave it"])
    if choice == 1 and "flashlight" not in inventory:
        inventory.append("flashlight")  # adds the flashlight to said inventory list so that you can use it later in the cellar
        print("You took the flashlight. The soup bubbles angrily.")
    hall()  # takes you back to the hall after your choice, no matter what you picked


def cellar():
    """Cellar: the ending depends on whether you have the flashlight."""
    print("\nYou creep down into the cellar. The stairs creak. Something\n"
          "clears its throat in the dark...")
    if "flashlight" in inventory:
        end("treasure")
    else:
        end("fell")


def bedroom():
    """Upstairs bedroom: two risky choices."""
    print("\nIn the bedroom, the wardrobe creaks and something inside it\n"
          "sneezes. The window is wide open and the night air is cold.")
    choice = ask(["Open the wardrobe", "Jump out the window"])
    if choice == 1:
        end("ghost")
    else:
        end("window")


def play_again():
    """Ask the player if they want to retry. Return True for yes, False for no."""
    while True:  # will keep asking until the answer is vaild if not will keep looping till you pick y/n
        answer = input("\nPlay again? (y/n) > ").strip().lower()
        if answer in ("y", "yes"):
            return True
        if answer in ("n", "no"):
            return False
        print("Please type y or n.")


print("=== SPOOKY HOUSE ===")
playing = True
while playing:
    inventory.clear()  # emptys inventory for the new game
    start()
    playing = play_again()
print("Thanks for playing!")
